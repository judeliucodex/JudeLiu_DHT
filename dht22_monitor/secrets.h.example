// Template for secrets.h — copy this file to secrets.h and fill in real values.
//
//   cp secrets.h.example secrets.h
//
// secrets.h is git-ignored, so the real credentials never enter the repository.
// Both values are only the *starting* credentials: the device stores whatever
// you enter in its setup portal into NVS flash, and the setup portal is how you
// change them without re-flashing.
#pragma once

// Wi-Fi network the device tries first at boot. If joining fails for 60 s it
// hosts its own access point ("ROV-DHT22-Setup", http://192.168.4.1) instead.
const char* WIFI_DEFAULT_SSID = "YOUR_WIFI_SSID";
const char* WIFI_DEFAULT_PASS = "YOUR_WIFI_PASSWORD";

// Shared secret validated by the Supabase INSERT policy.
// Generate one with:  openssl rand -hex 32
const char* DEVICE_KEY = "REPLACE_WITH_A_RANDOM_64_HEX_CHARACTER_KEY";
